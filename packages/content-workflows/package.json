{
  "name": "@maomao/content-workflows",
  "version": "0.1.0",
  "description": "毛毛星 Creator — ContentWorkflows action engine. ContentProjects = state, ContentWorkflows = action (Phase 3).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
