      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-typert-registry"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
