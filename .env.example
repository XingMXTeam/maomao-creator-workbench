# Maomao Creator Workbench — environment template
# Copy to .env and fill in ONLY the integrations you actually configure.
# Never commit real values. All integrations are optional; the workbench
# works without any of them and shows "Coming Soon" in the Settings card.

# ── Optional platform integrations (future) ──────────────────────────────
NOTION_API_KEY=
CANVA_API_KEY=

# ── Optional DeepSeek Harness model routing ──────────────────────────────
# (Harness normally reads credentials from its own profile; leave empty here
#  unless you run the workbench standalone.)
DEEPSEEK_API_KEY=
